# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Required in production. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Required by `npm run seed` when it needs to create the initial admin user.
# Use a unique password with at least 12 characters. Do not commit the real value.
SEED_ADMIN_PASSWORD=
