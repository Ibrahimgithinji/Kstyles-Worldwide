# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Required in production. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Required by `npm run seed` when it needs to create the initial admin user.
# Use a unique password with at least 12 characters. Do not commit the real value.
SEED_ADMIN_PASSWORD=

# Store WhatsApp number (international format, digits only) for design-order
# notifications. Public value — safe to commit a non-personal number, otherwise
# set in .env only. Example: 254712345678
NEXT_PUBLIC_STORE_WHATSAPP=

# Public site URL used to build links in outgoing emails (e.g. password reset).
# Required in production and must begin with https://. In dev, it defaults to
# http://localhost:3000 when unset.
APP_URL=https://your-domain.com

# Email delivery. Local development defaults to EMAIL_MODE=log, which prints
# emails to the terminal. Production rejects log mode: set one provider and a
# verified sender instead. Do not add real credentials to this file.
# EMAIL_MODE=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Kstyles Worldwide <no-reply@your-domain.com>
#
# Or use SMTP:
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASS=your-password
