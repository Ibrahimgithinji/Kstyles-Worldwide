# Copy this file to .env and fill in real values. NEVER commit .env itself.

# Required in production. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Required by `npm run seed` when it needs to create the initial admin user.
# Use a unique password with at least 12 characters. Do not commit the real value.
SEED_ADMIN_PASSWORD=

# Store WhatsApp number (international format, digits only) for design-order
# notifications. Public value — safe to commit a non-personal number, otherwise
# set in .env only. Example: 254712345678
NEXT_PUBLIC_STORE_WHATSAPP=

# Public site URL used to build links in outgoing emails (e.g. password reset).
# In dev, defaults to http://localhost:3000 when unset.
APP_URL=https://your-domain.com

# Email sending mode. Default "log" prints emails to the server console
# (works for local testing — reset links appear in the terminal).
# Providers are not configured yet; when one is added, set:
# EMAIL_MODE=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Kstyles Worldwide <no-reply@your-domain.com>
